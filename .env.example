# Copy to backend/.env and fill keys. Never commit the real file.

# LLM — required from Phase 3 (extraction / explanation / chat)
GEMINI_API_KEY=
GROQ_API_KEY=
PRIMARY_LLM=gemini

# Local data paths (Railway uses /app/data/...)
SQLITE_PATH=./data/sqlite/policy_intel.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# App
MAX_PDF_SIZE_MB=10
MAX_CHUNKS_PER_POLICY=500
EMBEDDING_MODEL=all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:3000

# Stay under free-tier RPM
GEMINI_RPM_LIMIT=14
GROQ_RPM_LIMIT=28
